# Copy this file to .env.local for local use, or add these in Vercel > Project > Settings > Environment Variables.
# Leave a key empty and the site runs in demo mode for that part (sample data, no costs).

# Claude (recognises the product in the screenshot). Get it at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# SerpApi (Google Shopping prices per country). Get it at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# FREE: Gemini (Google) for smarter recognition and the exact-match check. No credit card needed.
# Get it at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default: gemini-3.5-flash
GEMINI_MODEL=

# FREE: eBay Browse API, adds eBay offers from NL, BE, DE, FR, IT, ES, AT, IE, PL. Production keyset at https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional settings
# Which AI to prefer when both Claude and Gemini keys are set: claude or gemini
AI_PROVIDER=
# Which Claude model to use. Default: claude-opus-5-5
CLAUDE_MODEL=
# Countries to search, as two-letter codes. Every country costs one SerpApi search per user search.
# Default: nl,de,be,fr,it,es
SEARCH_COUNTRIES=
# Country the customer lives in (used for the "usual price" comparison). Default: nl
HOME_COUNTRY=

# Maintenance switch: set to true to take the site offline (shows "Coming soon", search API closed)
MAINTENANCE_MODE=
# Secret word that lets you still see the real site: visit /?preview=<this word> once
MAINTENANCE_BYPASS=
